__pycache__/
*.pyc

# Pyodide for the tests that run the shell's Python runtime under Node (npm i --prefix web-tests pyodide@314.0.7)
/web-tests/node_modules/
/web-tests/package*.json
# the page's vendored wheels (python3 dev/tools/build/build.py)
/web/vendor/
# the version history the page reads, built from web/version_history.md (python3 dev/tools/build/version_history.py json)
/web/version_history.json
# the site the build assembles for the release beside the files tracked there (python3 dev/tools/build/build.py)
/dev/build/site/*
!/dev/build/site/analytics.js
!/dev/build/site/_redirects
