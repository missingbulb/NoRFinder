__pycache__/
*.pyc

# raw microscope data, fetched from Drive (python3 studies/nor/src/fetch_data.py), never committed
/studies/nor/data/raw/

# detection processing artifacts (image cache, perf timings), never committed
/studies/nor/detection/.cache/

# browser check (studies/nor/detection/browser), npm install output
/studies/nor/detection/browser/node_modules/
/studies/nor/detection/browser/package*.json
# the page's vendored wheels (python3 web/build.py) and the Pages deploy's assembled site
/web/vendor/
# the version history the page reads, built from web/version_history.md (python3 web/version_history.py json)
/web/version_history.json
/_site/
