        {"name": "Resources", "select": "#sb-res", "req": "req/shell/status-bar/resources",
          "children": [
            {"name": "Resources, unfolded", "select": "#sb-res-items", "req": "req/shell/status-bar/resources",
              "children": [
                {"name": "Storage", "select": "#sb-disk", "control": true, "req": "req/shell/status-bar/disk"},
                {"name": "Memory", "select": "#sb-memory", "control": true, "req": "req/shell/status-bar/memory"},
                {"name": "Network", "select": "#sb-net", "control": true, "req": "req/shell/status-bar/network"},
                {"name": "CPU", "select": "#sb-cpu", "control": true, "req": "req/shell/status-bar/cpu"}
              ]
            },
            {"name": "Resources icon", "select": "#sb-res-icon", "control": true, "req": "req/shell/status-bar/resources"}
          ]
        },
        {"name": "Online icon", "select": "#sb-online", "control": true, "req": "req/shell/status-bar/online"},
        {"name": "Report a problem", "select": "#sb-report", "control": true, "req": "req/shell/report/bug",
          "rule": [
            {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default"}
          ]
        },
        {"name": "Version", "select": "#sb-version", "control": true, "req": "req/shell/version-history"},
        {"name": "What's new", "select": "#whats-new", "req": "req/shell/version-history",
          "rule": [
            {"is": "hidden"}
          ],
          "children": [
            {"name": "What's new, open", "select": "#whats-new-open", "control": true, "req": "req/shell/version-history"},
            {"name": "What's new, close", "select": "#whats-new-x", "control": true, "req": "req/shell/version-history"}
          ]
        }
      ]
    },
    {"name": "Tooltip", "select": "#tip", "req": "req/shell/channels/rows",
      "rule": [
        {"is": "hidden"}
      ]
    },
    {"name": "Icons", "select": "#icons", "req": "req/shell/header",
      "rule": [
        {"is": "hidden"}
      ]
    },
    {"name": "Notice", "select": "#notice", "req": "req/shell/ground-truth/submit",
      "rule": [
        {"when": {"notice": [false]}, "is": "hidden", "approval": "tentative"}
      ],
      "children": [
        {"name": "Notice's text", "select": "#notice-text", "req": "req/shell/ground-truth/submit"},
        {"name": "OK", "select": "#notice-ok", "control": true, "req": "req/shell/ground-truth/submit"}
      ]
    }
  ]
}
