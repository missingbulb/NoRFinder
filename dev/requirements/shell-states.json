{
  "about": "The shell's elements, as a tree, and what each shows in every state the paths below reach (req/checks/shell-states). An element says only how it differs from its parent: its rule is a list of cases, the first whose `when` matches the state deciding, and an element with no rule shows as its parent does. A case is `owner` (the spec says so) unless it says `tentative` (Claude's call, not approved) or `undecided` (nobody has decided: not checked). The paths below open the study `study` names, the shell's test study, with its states.json grafted in; each other study's states.json may add paths of its own, opening it. dev/tools/build/shell_states.py turns this file, and every study's states.json, into the matrix and the browser test's expectations.",
  "study": "fixture",
  "vars": {
    "stage": [null, "PreGT", "GT", "PostGT", "Published"],
    "signedIn": [false, true],
    "role": ["viewer", "tagger", "data"],
    "image": ["none", "local", "preview", "original"],
    "counted": [false, true],
    "view": ["image", "items"],
    "selected": ["nothing", "folder", "image"],
    "online": [true, false],
    "editing": [false, true],
    "stack": [false, true],
    "fromComputer": [false, true],
    "hasSteps": [false, true],
    "itemView": [false, true],
    "notice": [false, true],
    "imageFits": [true, false]
  },
  "roots": {
    "GT, signed out": {"stage": "GT", "signedIn": false, "role": "viewer"},
    "GT, Viewer": {"stage": "GT", "signedIn": true, "role": "viewer"},
    "GT, Tagger": {"stage": "GT", "signedIn": true, "role": "tagger"},
    "PostGT, Tagger": {"stage": "PostGT", "signedIn": true, "role": "tagger"},
    "PreGT, signed out": {"stage": "PreGT", "signedIn": false, "role": "viewer"},
    "PreGT, Tagger": {"stage": "PreGT", "signedIn": true, "role": "tagger"},
    "Published, Viewer": {"stage": "Published", "signedIn": true, "role": "viewer"},
    "GT, Data Manager": {"stage": "GT", "signedIn": true, "role": "data"}
  },
  "paths": [
    {"root": "GT, signed out", "actions": ["load", "count", "items"]},
    {"root": "GT, Viewer", "actions": ["load", "tagger"]},
    {"root": "GT, Tagger", "actions": ["load", "count"]},
    {"root": "PostGT, Tagger", "actions": ["load", "count"]},
    {"root": "PreGT, signed out", "actions": ["load", "count"]},
    {"root": "PreGT, Tagger", "actions": ["load", "count", "items"]},
    {"root": "Published, Viewer", "actions": ["load", "count", "items"]},
    {"root": "GT, Tagger", "actions": ["load", "offline", "online"]},
    {"root": "GT, Data Manager", "actions": ["folder", "preview", "original", "offline"]},
    {"root": "GT, Data Manager", "actions": ["folder", "preview", "edit", "offline", "done"]},
    {"root": "GT, Data Manager", "actions": ["folder", "offline", "online"]}
  ],
