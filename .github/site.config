# The page (web/) runs each study's Python as it sits in the repo, so the studies are published
# beside it, and a new study ships with no change here; the root index.html forwards to web/.
publish_root=.
publish_paths=index.html web studies
# fetches the third-party wheels the page installs (web/vendor/, not tracked)
build_command=python3 web/build.py
# written into web/config.js by the build: the Google API key that turns on loading from Google
# Drive, and the folder link that option opens on
build_vars=GOOGLE_API_KEY DRIVE_DEFAULT_FOLDER
