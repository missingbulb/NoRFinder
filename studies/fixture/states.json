{
  "about": "The fixture study's own elements in the shell's states (req/checks/shell-states, req/checks/spec-layout): each graft puts its tree under the shell's element `under`, after its child `after` or first, in the tree of dev/requirements/shell-states.json, whose rules they follow.",
  "grafts": [
    {"under": "Processing", "after": "Algorithms", "tree": [
      {"name": "Study: its processing", "select": "#fx-box", "req": "req/shell/study/knows-none",
        "children": [
          {"name": "Threshold", "select": "#fx-threshold", "control": true, "req": "req/shell/study/knows-none"},
          {"name": "Count", "select": "#fx-count", "control": true, "req": "req/shell/study/knows-none"}
        ]
      }
    ]},
    {"under": "Ground Truth Tasks", "tree": [
      {"name": "Study: count", "select": "#fx-result", "req": "req/shell/study/knows-none"},
      {"name": "Study: postprocessing", "select": "#fx-counted", "req": "req/shell/account/role"},
      {"name": "Study: the count is right", "select": "#fx-check", "req": "req/shell/ground-truth/tasks",
        "children": [
          {"name": "Study: its tick", "select": "#fx-done", "control": true, "req": "req/shell/ground-truth/tasks"}
        ]
      }
    ]},
    {"under": "Summary", "tree": [
      {"name": "Study: count summed up", "select": "#fx-sum", "req": "req/shell/study/knows-none"}
    ]},
    {"under": "Main view", "after": "Image view", "tree": [
      {"name": "Item view", "select": "#items-view", "req": "req/shell/views/second",
        "rule": [
          {"when": {"view": ["image"]}, "is": "hidden"}
        ],
        "children": [
          {"name": "Study: its item", "select": "#fx-item", "req": "req/shell/views/second"}
        ]
      }
    ]}
  ]
}
