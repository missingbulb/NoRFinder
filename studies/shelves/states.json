{
  "about": "The Bookshelf Reader's own elements in the shell's states (req/checks/shell-states, req/checks/spec-layout): each graft puts its tree under the shell's element `under`, after its child `after` or first, in the tree of dev/requirements/shell-states.json, whose rules they follow; its roots and paths open this study. `counted` is its first step, Find books, done.",
  "grafts": [
    {"under": "Processing", "tree": [
      {"name": "Reader", "select": "#bs-reader", "control": true, "req": "req/shelves/read/readers"},
      {"name": "Find books", "select": "#bs-find", "control": true, "req": "req/shelves/books/find"},
      {"name": "Read titles", "select": "#bs-read", "control": true, "req": "req/shelves/read/readers",
        "rule": [
          {"when": {"counted": [false]}, "is": "disabled"}
        ]
      },
      {"name": "Books found", "select": "#bs-found", "req": "req/shelves/books/find"}
    ]},
    {"under": "Ground Truth Tasks", "tree": [
      {"name": "What the tasks are", "select": "#bs-tasks", "req": "req/shelves/truth/task"}
    ]},
    {"under": "Summary", "tree": [
      {"name": "Titles' list", "select": "#bs-list", "req": "req/shelves/read/readers"},
      {"name": "Download for the matcher", "select": "#bs-export", "control": true, "req": "req/shelves/matcher/export",
        "rule": [
          {"when": {"counted": [false]}, "is": "disabled"}
        ]
      }
    ]},
    {"under": "Image view", "after": "Minimap", "tree": [
      {"name": "Drawing hint", "select": "#bs-draw-hint", "req": "req/shelves/truth/task",
        "rule": [
          {"is": "hidden"}
        ]
      }
    ]}
  ],
  "roots": {
    "GT, Viewer": {"stage": "GT", "signedIn": true, "role": "viewer"},
    "GT, Tagger": {"stage": "GT", "signedIn": true, "role": "tagger"}
  },
  "paths": [
    {"root": "GT, Viewer", "actions": ["load"]},
    {"root": "GT, Tagger", "actions": ["load"]}
  ]
}
