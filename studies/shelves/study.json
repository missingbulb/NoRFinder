{
  "id": "shelves",
  "title": "Bookshelf Reader",
  "description": "Each book on a photo of bookshelves boxed and its title read, in Hebrew and English.",
  "visibility": {
    "accounts": [
      "arielra@gmail.com"
    ]
  },
  "stage": "GT",
  "icon": "web/icon.svg",
  "poster": "web/poster.jpg",
  "phases": [
    {
      "key": "find",
      "name": "Find books",
      "button": "#bs-find"
    },
    {
      "key": "read",
      "name": "Read titles",
      "button": "#bs-read"
    }
  ],
  "viewer": "image2d",
  "python": {
    "paths": [
      "py/"
    ],
    "entry": "shelves",
    "packages": [
      "numpy",
      "scipy",
      "scikit-image",
      "lazy-loader",
      "packaging",
      "pillow",
      "pillow-heif"
    ],
    "wheels": []
  },
  "web": {
    "module": "web/shelves.js",
    "panels": "web/shelves.html",
    "style": "web/shelves.css",
    "offline": [
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort.wasm.min.mjs",
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort-wasm-simd-threaded.mjs",
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort-wasm-simd-threaded.wasm",
      "https://cdn.jsdelivr.net/npm/@gutenye/ocr-models@1.4.2/assets/ch_PP-OCRv4_det_infer.onnx",
      "https://cdn.jsdelivr.net/gh/hermitdave/FrequencyWords@525f9b560de45753a5ea01069454e72e9aa541c6/content/2018/he/he_50k.txt"
    ]
  },
  "root": "https://drive.google.com/drive/folders/10IrHmFgIdTlhwcZM0gGlfmw4TCM6_gwj",
  "files": {
    "from": [
      "drive"
    ],
    "accept": ".jpg,.jpeg,.png,.webp,.tif,.tiff,.bmp,.heic,.heif",
    "empty": "Load a photo of bookshelves (JPEG, PNG, WebP, TIFF or HEIC), then press Find books."
  },
  "channels": [
    {
      "name": "Red",
      "colour": "#ff0000",
      "shown": true,
      "about": "The photo's red. The three colours together are the photo as the camera took it."
    },
    {
      "name": "Green",
      "colour": "#00ff00",
      "shown": true,
      "about": "The photo's green. The three colours together are the photo as the camera took it."
    },
    {
      "name": "Blue",
      "colour": "#0000ff",
      "shown": true,
      "about": "The photo's blue. The three colours together are the photo as the camera took it."
    }
  ],
  "progress": {
    "install": "Installing numpy, scipy, scikit-image, Pillow, pillow-heif…",
    "load": "Loading the book finder…",
    "open": "Reading the photo…",
    "view": "Getting the photo ready for the text finder…",
    "find": "Finding the books…",
    "straighten": "Straightening each book…"
  },
  "groundTruth": {
  },
  "view": {
    "stretch": false,
    "hide": [
      "ruler",
      "grid",
      "channels"
    ]
  }
}
