{
  "about": "The NoR Finder's own elements in the shell's states (req/checks/shell-states, req/checks/spec-layout): each graft puts its tree under the shell's element `under`, after its child `after` or first, in the tree of dev/requirements/shell-states.json, whose rules they follow; its roots and paths open this study. `counted` is its first step, Run algorithm, done.",
  "grafts": [
    {"under": "Processing", "tree": [
      {"name": "Algorithm", "select": "#finder", "control": true, "req": "req/nor/find/finders"},
      {"name": "About the algorithm", "select": "#about-box", "req": "req/nor/find/finders"},
      {"name": "Settings", "select": "#settings-box", "req": "req/nor/find/settings"},
      {"name": "Run algorithm", "select": "#find", "control": true, "req": "req/nor/find/one-slow-step"}
    ]},
    {"under": "Main view", "after": "Tasks/Items switch", "tree": [
      {"name": "Show menu", "select": "#show-menu", "req": "req/nor/show-menu"},
      {"name": "Passed and failed tabs", "select": "#tab-pass", "control": true, "req": "req/nor/candidates/decide",
        "rule": [
          {"when": {"view": ["image"]}, "is": "hidden", "req": "req/shell/views/second"}
        ]
      },
      {"name": "Card menu", "select": "#card-menu", "req": "req/nor/cards/views",
        "rule": [
          {"when": {"view": ["image"]}, "is": "hidden", "req": "req/shell/views/second"}
        ]
      }
    ]},
    {"under": "Main view", "after": "Busy", "tree": [
      {"name": "Lasso hint", "select": "#lasso-hint", "req": "req/nor/summary/mask",
        "rule": [
          {"is": "hidden"}
        ]
      }
    ]},
    {"under": "Image view", "after": "Minimap", "tree": [
      {"name": "Selected item", "select": "#selected-box", "req": "req/nor/candidates/decide",
        "rule": [
          {"is": "hidden"}
        ]
      }
    ]},
    {"under": "Main view", "after": "Image view", "tree": [
      {"name": "Item view", "select": "#items-view", "req": "req/shell/views/second",
        "rule": [
          {"when": {"view": ["image"]}, "is": "hidden"}
        ]
      }
    ]}
  ],
  "roots": {
    "GT, signed out": {"stage": "GT", "signedIn": false, "role": "viewer"},
    "GT, Tagger": {"stage": "GT", "signedIn": true, "role": "tagger"}
  },
  "paths": [
    {"root": "GT, signed out", "actions": ["load"]},
    {"root": "GT, Tagger", "actions": ["load"]}
  ]
}
